doctype html
html
  head
    meta(charset="UTF-8")
    title You're Invited!
    style.
      body {
        font-family: Arial, sans-serif;
        background: #f8f8f8;
        padding: 20px;
      }
      .content {
        background: #fff;
        padding: 20px;
        border-radius: 5px;
      }

  body
    .content
      h1 You’ve been invited to join #{storeName}!
      p Hello,
      p You have been invited to create an account for managing the #{storeName} store.
      p Click the link below to accept your invitation and set up your account:
      p
        a(href=inviteLink, style="color: #4CAF50; text-decoration: none; font-weight: bold;")
          Accept Invitation
      p This invitation will expire in 7 days.
      p If you did not expect this email, you can safely ignore it.
